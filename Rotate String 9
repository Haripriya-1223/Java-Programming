import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String s = sc.nextLine();
        String goal = sc.nextLine();

        if (s.length() == goal.length() && (s + s).contains(goal)) {
            System.out.println("true");
        } else {
            System.out.println("false");
        }

        sc.close();
    }
}
